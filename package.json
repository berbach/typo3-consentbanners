{
    "name": "consent_banner",
    "version": "1.0.0",
    "description": "Consent Banner style",
    "author": "Andreas Schulze",
    "repository": {
        "type": "git",
        "url": "https://github.com/npm/cli.git"
    },
    "license": "(MIT)",
    "main": "Base.js",
    "scripts": {
        "build": "webpack build --mode=production --config style.webpack.js && webpack build --mode=production --config script.webpack.js",
        "build:dev": "webpack build --mode=development --config style.webpack.js && webpack build --mode=development --config script.webpack.js",
        "script:dev": "webpack build --mode=development --config script.webpack.js",
        "style:dev": "webpack build --mode=development --config style.webpack.js",
        "script": "webpack --mode=production --config script.webpack.js",
        "style": "webpack --mode=production --config style.webpack.js"
    },
    "dependencies": {
        "bezier-easing": "^2.1.0",
        "core-js": "^3.16.4"
    },
    "devDependencies": {
        "@babel/core": "^7.17.5",
        "@babel/plugin-syntax-dynamic-import": "^7.8.3",
        "@babel/plugin-transform-runtime": "^7.17.0",
        "@babel/preset-env": "^7.15.4",
        "@babel/register": "^7.15.3",
        "autoprefixer": "^10.4.20",
        "babel-loader": "^8.2.3",
        "clean-css": "^5.3.1",
        "clean-webpack-plugin": "^4.0.0",
        "css-loader": "^7.1.2",
        "css-minimizer-webpack-plugin": "^8.0.0",
        "cssnano": "^5.1.14",
        "fast-glob": "^3.2.7",
        "file-loader": "^6.2.0",
        "mini-css-extract-plugin": "^2.7.2",
        "path": "^0.12.7",
        "postcss": "^8.4.31",
        "postcss-loader": "^8.1.1",
        "postinstall": "^0.11.2",
        "resolve-url-loader": "^5.0.0",
        "sass": "^1.79.1",
        "sass-loader": "^16.0.2",
        "sass-migrator": "^1.5.3",
        "style-loader": "^4.0.0",
        "terser-webpack-plugin": "^5.3.6",
        "uglify-js": "^3.14.2",
        "webpack": "^5.95.0",
        "webpack-cli": "^5.1.4"
    }
}
