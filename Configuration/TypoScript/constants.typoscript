}

module.tx_consentbanner {
    view {
        # cat=Module Consentbanner Config/file; type=string; label=Path to template root (BE)
        templateRootPath = EXT:consent_banner/Resources/Private/Backend/Templates/
        # cat=Module Consentbanner Config/file; type=string; label=Path to template partials (BE)
        partialRootPath = EXT:consent_banner/Resources/Private/Backend/Partials/
        # cat=Module Consentbanner Config/file; type=string; label=Path to template layouts (BE)
        layoutRootPath = EXT:consent_banner/Resources/Private/Backend/Layouts/
