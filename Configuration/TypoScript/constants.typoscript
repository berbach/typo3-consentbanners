plugin.tx_consentbanner {
    settings {

    }

    view {
        # cat=Consentbanner Config/file; type=string; label=Path to template root (FE)
        templateRootPath = EXT:consent_banner/Resources/Private/Templates/
        # cat=Consentbanner Config/file; type=string; label=Path to template partials (FE)
        partialRootPath = EXT:consent_banner/Resources/Private/Partials/
        # cat=Consentbanner Config/file; type=string; label=Path to template layouts (FE)
        layoutRootPath = EXT:consent_banner/Resources/Private/Layouts/
