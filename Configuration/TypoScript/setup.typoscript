plugin.tx_consentbanner {
    view {
        templateRootPaths {
            0 = EXT:consent_banner/Resources/Private/Templates/
            10 = {$plugin.tx_consentbanner.view.templateRootPath}
        }
        partialRootPaths {
            0 = EXT:consent_banner/Resources/Private/Partials/
            10 = {$plugin.tx_consentbanner.view.partialRootPath}
        }
        layoutRootPaths {
            0 = EXT:consent_banner/Resources/Private/Layouts/
            10 = {$plugin.tx_consentbanner.view.layoutRootPath}
        }
    }
    persistence {

    }
    features {
        #skipDefaultArguments = 1
        # if set to 1, the enable fields are ignored in BE context
        ignoreAllEnableFieldsInBe = 0
        # Should be on by default, but can be disabled if all action in the plugin are uncached
        requireCHashArgumentForActionArguments = 1
    }

    mvc {
        callDefaultActionIfActionCantBeResolved = 1
    }

    settings {

    }
}

lib.consentbanners = COA_INT
lib.consentbanners {
    10 = FLUIDTEMPLATE
    10 {
        templateName = ConsentBanner

        templateRootPaths < plugin.tx_consentbanner.view.templateRootPaths
        partialRootPaths < plugin.tx_consentbanner.view.partialRootPaths
        layoutRootPaths < plugin.tx_consentbanner.view.layoutRootPaths

        settings < plugin.tx_consentbanner.settings

        dataProcessing {
            10 = Bb\ConsentBanner\DataProcessing\ConsentBannerProcessor
        }
    }
}

page {

    # Google Consent Mode bootstrap (gtag default/update + GTM loader), rendered
    # uncached and early in <head> before the Google tags fire.
    headerData.1633505734 = USER_INT
    headerData.1633505734 {
        userFunc = Bb\ConsentBanner\Frontend\ConsentModeRenderer->render
    }

    1633505733 < lib.consentbanners

    includeCSS {
        consentbanner = EXT:consent_banner/Resources/Public/Dist/Css/ConsentBanner.css
        consentbanner.forceOnTop = 1
    }

    includeJSFooter {
        consentbanner = EXT:consent_banner/Resources/Public/Dist/JavaScript/CbLoader.js
        consentbanner.async = 1
        consentbanner.excludeFromConcatenation = 1
        consentbanner.disableCompression = 1
    }
}

tt_content.html {
    templateRootPaths {
        200 = EXT:consent_banner/Resources/Private/Templates/
    }
}

